{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/ask",
      "destination": "/api/ask"
    }
  ],
  "headers": [
    {
      "source": "/api/ask",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}